---
import { nav } from "../data/site";
import { getArticles } from "../lib/articles";

interface Props {
    active?: string;
    showControls?: boolean;
}

const { active, showControls = false } = Astro.props;

// Articles earns its nav slot by having something in it. Until the first piece
// lands, the link would point at an empty page, so it's dropped here rather
// than being commented in and out of site.ts by hand.
const hasArticles = (await getArticles()).length > 0;
const items = nav.filter((n) => n.href !== "/articles" || hasArticles);
---

<div class="statusbar">
    <a class="brand" href="/"
        ><span class="blink"></span><span>ALEXANDRU BADIU · 48K</span></a
    >
    <!-- Phone-only. The links need ~415px and a phone gives the column ~337px,
         so below 640px they fold into the panel this opens. -->
    <button
        class="navtoggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
    >
        MENU
    </button>
    <div class="grp" id="nav-menu">
        {
            items.map((n) => (
                <a
                    class:list={["navlink", { active: active === n.href }]}
                    href={n.href}
                >
                    {n.label}
                </a>
            ))
        }
        {
            showControls && (
                <>
                    <button
                        id="sound-btn"
                        class="iconbtn"
                        title="Toggle bleeps"
                        aria-label="Toggle sound"
                    >
                        ♪
                    </button>
                    <button
                        id="replay-btn"
                        class="iconbtn"
                        title="Replay loading screen"
                        aria-label="Replay loader"
                    >
                        ⟲
                    </button>
                </>
            )
        }
    </div>
</div>

<script>
    // The collapsing menu is an enhancement: the js-nav class is what switches
    // the links from inline to a panel, so with no JS they stay inline and wrap,
    // which is worse-looking but still navigable.
    (function () {
        const bar = document.querySelector(".statusbar");
        const toggle = document.getElementById("nav-toggle");
        const menu = document.getElementById("nav-menu");
        if (!bar || !toggle || !menu) return;

        bar.classList.add("js-nav");
        toggle.addEventListener("click", function () {
            const open = menu.classList.toggle("open");
            toggle.setAttribute("aria-expanded", open ? "true" : "false");
        });
        // Escape closes it, the way any menu should.
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && menu.classList.contains("open")) {
                menu.classList.remove("open");
                toggle.setAttribute("aria-expanded", "false");
                toggle.focus();
            }
        });
    })();
</script>
